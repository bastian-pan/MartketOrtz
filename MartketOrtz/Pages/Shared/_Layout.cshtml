<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiniMarket Ortz</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MartketOrtz.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/boleta-print.css" />
</head>
<body>
    <header>
        <nav class="ortz-navbar">
            <div class="container">
                <div class="d-flex align-items-center justify-content-between">
                    <a class="ortz-brand" asp-area="" asp-page="/Index">
                        <img src="~/images/logo.png" alt="Ortz" class="ortz-logo" />
                        <span class="ortz-brand-text">MiniMarket <strong>Ortz</strong></span>
                    </a>

                    @if (ViewData["HideNav"] as bool? != true)
                    {
                        <button class="navbar-toggler ortz-toggler d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#navOrtz">
                            ☰
                        </button>

                        <div class="d-none d-lg-flex gap-1 align-items-center">
                            <a class="ortz-nav-link" asp-area="" asp-page="/Index">🏠 Inicio</a>
                            <a class="ortz-nav-link" asp-area="" asp-page="/GestionCategoria">🏷️ Categorías</a>
                            <a class="ortz-nav-link" asp-area="" asp-page="/GestionProducto">📦 Productos</a>
                            <a class="ortz-nav-link" asp-area="" asp-page="/GestionVenta">🛒 Ventas</a>
                            <a class="ortz-nav-link text-danger fw-bold ms-3" asp-area="" asp-page="/Logout">🚪 Cerrar Sesión</a>
                        </div>
                    }
                </div>

                @if (ViewData["HideNav"] as bool? != true)
                {
                    <div class="collapse d-lg-none" id="navOrtz">
                        <div class="d-flex flex-column py-2 gap-1">
                            <a class="ortz-nav-link" asp-area="" asp-page="/Index">🏠 Inicio</a>
                            <a class="ortz-nav-link" asp-area="" asp-page="/GestionCategoria">🏷️ Categorías</a>
                            <a class="ortz-nav-link" asp-area="" asp-page="/GestionProducto">📦 Productos</a>
                            <a class="ortz-nav-link" asp-area="" asp-page="/GestionVenta">🛒 Ventas</a>
                            <a class="ortz-nav-link text-danger fw-bold" asp-area="" asp-page="/Logout">🚪 Cerrar Sesión</a>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>

    <div class="ortz-page-wrapper">
        <div class="container py-4">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="ortz-footer">
        <div class="container text-center">
            <img src="~/images/logo.png" alt="Ortz" style="height:36px; opacity:0.85;" />
            <p class="mb-0 mt-1" style="font-size:13px; opacity:0.7;">
                &copy; 2026 MiniMarket Ortz — Todos los derechos reservados
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>