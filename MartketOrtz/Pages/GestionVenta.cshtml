@page
@model MartketOrtz.Pages.GestionVentaModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Gestión de Ventas";
}

@Html.AntiForgeryToken()

<div class="container mt-4">
    <h2>Gestión de Ventas</h2>
    @if (TempData["MensajePago"] != null)
    {
        <div class="alert alert-info">@TempData["MensajePago"]</div>
    }
    <hr />

    <div class="row">
        <div class="col-md-6 pe-4 border-end">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post" asp-page-handler="Agregar" id="formAgregar" class="row g-3 align-items-end mb-2">
                        <div class="col-md-6">
                            <label for="seleccionarProducto" class="form-label fw-bold">Producto:</label>
                            <select class="form-select" id="seleccionarProducto" asp-for="IdProductoSeleccionado" required>
                                <option value="">- Seleccionar -</option>
                                @if (Model.Productos != null)
                                {
                                    @foreach (var p in Model.Productos)
                                    {
                                        <option value="@p.producto.IdProducto">@p.producto.Nombre</option>
                                    }
                                }
                            </select>
                            <div class="mt-2 text-muted small">
                                <span>Precio: $<span id="lblPrecio">0</span></span> |
                                <span>Stock: <span id="lblStock">0</span></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label for="inputCantidad" class="form-label fw-bold">Cantidad:</label>
                            <input class="form-control" id="inputCantidad" type="number" min="1" asp-for="Cantidad" required />
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary w-100">Agregar</button>
                        </div>
                    </form>
                </div>
            </div>

            <form id="formAccionesCarrito" method="post">
                <table class="table table-bordered table-striped table-sm">
                    <thead class="table-dark">
                        <tr>
                            <th class="text-center">Sel.</th>
                            <th>Producto</th>
                            <th>Cant.</th>
                            <th>Precio</th>
                            <th>IVA</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Carrito != null && Model.Carrito.Count > 0)
                        {
                            int index = 0;
                            foreach (var item in Model.Carrito)
                            {
                                <tr>
                                    <td class="text-center">
                                        <input class="form-check-input" type="radio" name="IndexEditar" value="@index" />
                                    </td>
                                    <td>@item.NombreProducto</td>
                                    <td>@item.Cantidad</td>
                                    <td>$@item.PrecioUnitario.ToString("0")</td>
                                    <td>$@item.IVA.ToString("0")</td>
                                    <td>$@item.SubTotal.ToString("0")</td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="text-center">El carrito está vacío</td></tr>
                        }
                    </tbody>
                </table>

                <div class="row g-2 mt-2">
                    <div class="col-4">
                        <button type="submit" asp-page-handler="Editar" class="btn btn-warning w-100">Editar</button>
                    </div>
                    <div class="col-4">
                        <button type="submit" asp-page-handler="EliminarItem" class="btn btn-danger w-100">Eliminar</button>
                    </div>
                    <div class="col-4">
                        <button type="submit" asp-page-handler="Cancelar" class="btn btn-secondary w-100" formnovalidate>Cancelar</button>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" asp-page-handler="Pagar" class="btn btn-success w-100 py-2 fs-5" formnovalidate>
                        💳 Pagar con Webpay
                    </button>
                </div>
            </form>
        </div>

        <div class="col-md-6 ps-4">
            <form id="formAccionesVentas" method="post">
                <div class="row g-3 align-items-center mb-3">
                    <div class="col-auto">
                        <label class="col-form-label fw-bold">Actualizar Total ($):</label>
                    </div>
                    <div class="col">
                        <input type="number" step="0.01" class="form-control" id="txtNuevoTotal" asp-for="NuevoTotal" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" asp-page-handler="ActualizarVenta" id="btnActualizarVenta" class="btn btn-info text-white" formnovalidate>Actualizar Venta</button>
                    </div>
                </div>

                <table class="table table-bordered table-striped table-sm">
                    <thead class="table-dark">
                        <tr>
                            <th class="text-center"><input type="checkbox" id="chkSeleccionarTodas" class="form-check-input" /></th>
                            <th>Id Venta</th>
                            <th>Fecha</th>
                            <th>Total</th>
                            <th>IVA</th>
                            <th class="text-center">Boleta</th>
                            <th class="text-center">Editar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Ventas != null && Model.Ventas.Count > 0)
                        {
                            foreach (var v in Model.Ventas)
                            {
                                <tr id="filaVenta-@v.IdVenta">
                                    <td class="text-center">
                                        <input class="form-check-input chkVenta" type="checkbox" name="IdsVentasSeleccionadas" value="@v.IdVenta" data-total="@v.Total.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" />
                                    </td>
                                    <td>@v.IdVenta</td>
                                    <td>@v.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td class="fw-bold text-success" id="totalVenta-@v.IdVenta">$@v.Total.ToString("0")</td>
                                    <td id="ivaVenta-@v.IdVenta">$@v.IVA.ToString("0")</td>

                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-info text-white" onclick="imprimirBoleta(@v.IdVenta)">
                                            🧾 Ver
                                        </button>
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-warning" onclick="editarVenta(@v.IdVenta)">
                                             Editar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center">No hay ventas registradas</td></tr>
                        }
                    </tbody>
                </table>

                <div class="mt-3 text-start">
                    <button type="submit" asp-page-handler="EliminarVenta" class="btn btn-danger" formnovalidate>
                        Eliminar Venta
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (TempData["IdVentaGenerada"] != null)
{
    var idBoletaParaMostrar = (int)TempData["IdVentaGenerada"]!;
    <input type="hidden" id="hdnIdVentaRecienGenerada" value="@idBoletaParaMostrar" />
}

<div id="areaImpresion" class="ticket-print"></div>
<div class="modal fade" id="modalBoleta" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Boleta de Venta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="contenidoBoleta" class="ticket-print">
                    <div class="text-center py-4">Cargando...</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-success" onclick="imprimirContenidoBoleta()">🖨️ Imprimir</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalEditarVenta" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Venta #<span id="idVentaEditar"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="contenidoEditarVenta">
                    <div class="text-center py-4">Cargando...</div>
                </div>
                <div id="errorEditarVenta" class="text-danger small mt-2" style="display:none;"></div>
            </div>
            <div class="modal-footer">
                <span class="me-auto fw-bold">Nuevo Total: $<span id="totalEditarVenta">0</span></span>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-warning" id="btnGuardarEdicionVenta" onclick="guardarEdicionVenta()">💾 Guardar Cambios</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // info del precio y cantidad
        document.getElementById('seleccionarProducto').addEventListener('change', function () {
            var productId = this.value;
            if (productId) {
                fetch('?handler=ProductoInfo&id=' + productId)
                    .then(function (response) { return response.json(); })
                    .then(function (data) {
                        if (data) {
                            document.getElementById('lblPrecio').innerText = data.precio;
                            document.getElementById('lblStock').innerText = data.stock;
                            document.getElementById('inputCantidad').max = data.stock;
                        }
                    });
            } else {
                document.getElementById('lblPrecio').innerText = '0';
                document.getElementById('lblStock').innerText = '0';
                document.getElementById('inputCantidad').max = '';
            }
        });

        // logica de la seleccion de ventas
        var chkAll = document.getElementById('chkSeleccionarTodas');
        var checkboxes = document.querySelectorAll('.chkVenta');
        var txtTotal = document.getElementById('txtNuevoTotal');
        var btnActualizar = document.getElementById('btnActualizarVenta');

        // funcion para evaluar la cantidad de seleccionados y mostrar el total de la venta seleccionada
        function evaluarSeleccion() {
            var seleccionados = document.querySelectorAll('.chkVenta:checked');

            if (seleccionados.length === 1) {
                txtTotal.value = seleccionados[0].getAttribute('data-total');
            } else {
                txtTotal.value = '';
            }
        }

        // Seleccionar todas las ventas
        chkAll.addEventListener('change', function () {
            checkboxes.forEach(function (chk) {
                chk.checked = chkAll.checked;
            });
            evaluarSeleccion();
        });

   
        checkboxes.forEach(function (chk) {
            chk.addEventListener('change', function () {
                if (!this.checked) {
                    chkAll.checked = false;
                }
                evaluarSeleccion();
            });
        });


        btnActualizar.addEventListener('click', function (e) {
            var seleccionados = document.querySelectorAll('.chkVenta:checked');

            if (seleccionados.length > 1) {
                e.preventDefault();
                alert("Solo se puede actualizar una venta a la vez");
            } else if (seleccionados.length === 0) {
                e.preventDefault();
                alert("Debe seleccionar al menos una venta para poder actualizarla");
            }
        });


        var idVentaRecienGenerada = document.getElementById('hdnIdVentaRecienGenerada');
        if (idVentaRecienGenerada) {
            imprimirPdfEnIframe(idVentaRecienGenerada.value);
        }

        function obtenerDatosBoleta(id, callback) {
            fetch('/GestionVenta?handler=BoletaDetalle&id=' + id)
                .then(function (response) {
                    if (!response.ok) {
                        throw new Error("Error en el servidor");
                    }
                    return response.json();
                })
                .then(function (data) {
                    var htmlBoleta = construirHtmlBoleta(id, data);
                    callback(htmlBoleta);
                })
                .catch(function (error) {
                    console.error("Error Fetch:", error);
                    callback('<div class="text-center text-danger py-4">Ocurrio un error al cargar la boleta.</div>');
                });
        }


        function construirHtmlBoleta(id, data) {
            var fecha = data.fecha;
            var total = data.total;
            var iva = data.iva;
            var productos = data.productos;

            var listaProductosHTML = '';

            if (productos && productos.length > 0) {
                productos.forEach(function (p) {
                    var sub = p.subtotal ? p.subtotal : (p.precio * p.cantidad);
                    listaProductosHTML += '<div class="item"><span>' + p.cantidad + 'x ' + p.nombre + '</span> <span>$' + sub.toFixed(0) + '</span></div>';
                });
            } else {
                listaProductosHTML = '<div class="item" style="color:#666; font-style:italic;"><span>(Venta sin detalles registrados)</span></div>';
            }

            return '<h4>MiniMarket Ortz</h4>' +
                '<p>Boleta Electronica</p>' +
                '<div class="line"></div>' +
                '<div class="item"><span>N Venta:</span> <span>' + id + '</span></div>' +
                '<div class="item"><span>Fecha:</span> <span>' + fecha + '</span></div>' +
                '<div class="line"></div>' +
                listaProductosHTML +
                '<div class="line"></div>' +
                '<div class="item"><span>IVA (19%):</span> <span>$' + Math.round(iva) + '</span></div>' +
                '<div class="item" style="font-size: 16px; font-weight: bold;"><span>TOTAL:</span> <span>$' + Math.round(total) + '</span></div>' +
                '<div class="line"></div>' +
                '<p>Gracias por su compra!</p>';
        }

 
        var idVentaActualEnModal = null;
        function imprimirBoleta(id) {
            idVentaActualEnModal = id;

            var modalEl = document.getElementById('modalBoleta');
            var modal = new bootstrap.Modal(modalEl);
            var contenedor = document.getElementById('contenidoBoleta');

            contenedor.innerHTML = '<div class="text-center py-4">Cargando...</div>';
            modal.show();

            obtenerDatosBoleta(id, function (htmlBoleta) {
                contenedor.innerHTML = htmlBoleta;
            });
        }

  
        function imprimirContenidoBoleta() {
            if (idVentaActualEnModal) {
                imprimirPdfEnIframe(idVentaActualEnModal);
            }
        }


        function imprimirPdfEnIframe(id) {
            var iframe = document.createElement('iframe');
            iframe.style.position = 'fixed';
            iframe.style.right = '0';
            iframe.style.bottom = '0';
            iframe.style.width = '0';
            iframe.style.height = '0';
            iframe.style.border = '0';
            iframe.src = '/GestionVenta?handler=BoletaPdf&id=' + id;
            document.body.appendChild(iframe);

            iframe.addEventListener('load', function () {
                setTimeout(function () {
                    iframe.contentWindow.focus();
                    iframe.contentWindow.print();

                    setTimeout(function () {
                        document.body.removeChild(iframe);
                    }, 1000);
                }, 300);
            });
        }


        var idVentaActualEnEdicion = null;

        function editarVenta(id) {
            idVentaActualEnEdicion = id;
            document.getElementById('idVentaEditar').innerText = id;

            var contenedor = document.getElementById('contenidoEditarVenta');
            var errorDiv = document.getElementById('errorEditarVenta');
            errorDiv.style.display = 'none';
            contenedor.innerHTML = '<div class="text-center py-4">Cargando...</div>';

            var modal = new bootstrap.Modal(document.getElementById('modalEditarVenta'));
            modal.show();

            fetch('/GestionVenta?handler=DetalleEditarVenta&id=' + id)
                .then(function (response) {
                    if (!response.ok) throw new Error("Error en el servidor");
                    return response.json();
                })
                .then(function (data) {
                    construirTablaEdicion(data.items || []);
                })
                .catch(function () {
                    contenedor.innerHTML = '<div class="text-center text-danger py-4">Ocurrió un error al cargar los productos de la venta.</div>';
                });
        }


        function construirTablaEdicion(items) {
            var contenedor = document.getElementById('contenidoEditarVenta');

            if (!items || items.length === 0) {
                contenedor.innerHTML = '<div class="text-center text-muted py-4">Esta venta no tiene productos registrados.</div>';
                document.getElementById('totalEditarVenta').innerText = '0';
                return;
            }

            var html = '<table class="table table-bordered table-sm align-middle" id="tablaEdicionVenta">' +
                '<thead class="table-light"><tr>' +
                '<th>Producto</th><th style="width:120px;">Cantidad</th><th style="width:150px;">Precio Unit.</th><th class="text-end" style="width:130px;">Subtotal</th>' +
                '</tr></thead><tbody>';

            items.forEach(function (item, idx) {
                html += '<tr data-nombre="' + item.nombreProducto.replace(/"/g, '&quot;') + '">' +
                    '<td>' + item.nombreProducto + '</td>' +
                    '<td><input type="number" min="1" class="form-control form-control-sm input-cantidad-edicion" value="' + item.cantidad + '" /></td>' +
                    '<td><input type="number" min="0" step="1" class="form-control form-control-sm input-precio-edicion" value="' + item.precioUnitario + '" /></td>' +
                    '<td class="text-end fw-bold subtotal-edicion">$' + Math.round(item.cantidad * item.precioUnitario) + '</td>' +
                    '</tr>';
            });

            html += '</tbody></table>';
            contenedor.innerHTML = html;

            contenedor.querySelectorAll('.input-cantidad-edicion, .input-precio-edicion').forEach(function (input) {
                input.addEventListener('input', recalcularTotalesEdicion);
            });

            recalcularTotalesEdicion();
        }


        function recalcularTotalesEdicion() {
            var filas = document.querySelectorAll('#tablaEdicionVenta tbody tr');
            var totalGeneral = 0;

            filas.forEach(function (fila) {
                var cantidad = parseFloat(fila.querySelector('.input-cantidad-edicion').value) || 0;
                var precio = parseFloat(fila.querySelector('.input-precio-edicion').value) || 0;
                var subtotal = cantidad * precio;

                fila.querySelector('.subtotal-edicion').innerText = '$' + Math.round(subtotal);
                totalGeneral += subtotal;
            });

            document.getElementById('totalEditarVenta').innerText = Math.round(totalGeneral);
        }


        function guardarEdicionVenta() {
            if (!idVentaActualEnEdicion) return;

            var filas = document.querySelectorAll('#tablaEdicionVenta tbody tr');
            var errorDiv = document.getElementById('errorEditarVenta');
            errorDiv.style.display = 'none';

            if (filas.length === 0) return;

            var items = [];
            var datosValidos = true;

            filas.forEach(function (fila) {
                var nombre = fila.getAttribute('data-nombre');
                var cantidad = parseInt(fila.querySelector('.input-cantidad-edicion').value);
                var precio = parseFloat(fila.querySelector('.input-precio-edicion').value);

                if (isNaN(cantidad) || cantidad <= 0 || isNaN(precio) || precio < 0) {
                    datosValidos = false;
                }

                items.push({ nombreProducto: nombre, cantidad: cantidad, precioUnitario: precio });
            });

            if (!datosValidos) {
                errorDiv.innerText = 'Verifica que las cantidades y precios sean válidos.';
                errorDiv.style.display = 'block';
                return;
            }

            var btnGuardar = document.getElementById('btnGuardarEdicionVenta');
            btnGuardar.disabled = true;
            btnGuardar.innerText = 'Guardando...';

            var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            var token = tokenInput ? tokenInput.value : '';

            fetch('/GestionVenta?handler=GuardarEdicionVenta', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ idVenta: idVentaActualEnEdicion, items: items })
            })
                .then(function (response) {
                    if (!response.ok) {
                        return response.text().then(function (texto) {
                            throw new Error('HTTP ' + response.status + ': ' + texto);
                        });
                    }
                    return response.json();
                })
                .then(function (data) {
                    btnGuardar.disabled = false;
                    btnGuardar.innerText = '💾 Guardar Cambios';

                    if (data.success) {
             
                        var celdaTotal = document.getElementById('totalVenta-' + data.idVenta);
                        var celdaIva = document.getElementById('ivaVenta-' + data.idVenta);
                        if (celdaTotal) celdaTotal.innerText = '$' + Math.round(data.total);
                        if (celdaIva) celdaIva.innerText = '$' + Math.round(data.iva);

                     
                        var checkbox = document.querySelector('.chkVenta[value="' + data.idVenta + '"]');
                        if (checkbox) checkbox.setAttribute('data-total', data.total.toFixed(2));

                        var modal = bootstrap.Modal.getInstance(document.getElementById('modalEditarVenta'));
                        modal.hide();
                    } else {
                        errorDiv.innerText = data.mensaje || 'No se pudo guardar la edición.';
                        errorDiv.style.display = 'block';
                    }
                })
                .catch(function (error) {
                    console.error('Error al guardar edición de venta:', error);
                    btnGuardar.disabled = false;
                    btnGuardar.innerText = '💾 Guardar Cambios';
                    errorDiv.innerText = 'Ocurrió un error al guardar. Detalle: ' + error.message;
                    errorDiv.style.display = 'block';
                });
        }
    </script>
}
